int trap(int* height, int heightSize) {
    if (heightSize == 0) return 0;
    
    int left = 0;
    int right = heightSize - 1;
    int leftMax = 0;
    int rightMax = 0;
    int trappedWater = 0;
    
    while (left < right) {
        // The water level is limited by the smaller side
        if (height[left] < height[right]) {
            if (height[left] >= leftMax) {
                leftMax = height[left]; // Update left max boundary
            } else {
                trappedWater += leftMax - height[left]; // Add trapped water
            }
            left++;
        } else {
            if (height[right] >= rightMax) {
                rightMax = height[right]; // Update right max boundary
            } else {
                trappedWater += rightMax - height[right]; // Add trapped water
            }
            right--;
        }
    }
    
    return trappedWater;
}
