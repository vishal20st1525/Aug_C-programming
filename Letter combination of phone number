#include <stdlib.h>
#include <string.h>

// Global phone mapping for quick lookup
static const char* phoneMap[] = {
    "", "", "abc", "def", "ghi", "jkl", "mno", "pqrs", "tuv", "wxyz"
};

void backtrack(char* digits, int index, char* current, char** result, int* returnSize) {
    // Base case: if we reached the end of the input string
    if (digits[index] == '\0') {
        result[*returnSize] = strdup(current);
        (*returnSize)++;
        return;
    }
    
    int digit = digits[index] - '0';
    const char* letters = phoneMap[digit];
    
    // Loop through each letter mapped to the current digit
    for (int i = 0; letters[i] != '\0'; i++) {
        current[index] = letters[i]; // Choose
        backtrack(digits, index + 1, current, result, returnSize); // Recurse
    }
}

char** letterCombinations(char* digits, int* returnSize) {
    *returnSize = 0;
    int len = strlen(digits);
    
    // Edge case: if input string is empty
    if (len == 0) {
        return NULL;
    }
    
    // Calculate total number of combinations to allocate memory
    int totalCombinations = 1;
    for (int i = 0; i < len; i++) {
        int digit = digits[i] - '0';
        if (digit == 7 || digit == 9) {
            totalCombinations *= 4;
        } else {
            totalCombinations *= 3;
        }
    }
    
    // Allocate array of string pointers
    char** result = (char**)malloc(totalCombinations * sizeof(char*));
    
    // Temporary buffer to track current combination path (+1 for '\0')
    char* current = (char*)malloc((len + 1) * sizeof(char));
    current[len] = '\0';
    
    // Start generating combinations
    backtrack(digits, 0, current, result, returnSize);
    
    // Free the temporary buffer
    free(current);
    
    return result;
}
