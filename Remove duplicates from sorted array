int removeDuplicates(int* nums, int numsSize) {
    if (numsSize == 0) {
        return 0;
    }
    
    // 'k' tracks the count of unique elements and where to write next
    int k = 1; 
    
    for (int i = 1; i < numsSize; i++) {
        // If the current element is different from the previous one, it's unique
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i];
            k++;
        }
    }
    
    return k;
}
