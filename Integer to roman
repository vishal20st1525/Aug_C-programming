#include <string.h>

char* intToRoman(int num) {
    // Array of Roman numeral values in descending order
    int values[] = {1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1};
    // Corresponding Roman numeral symbols
    char* symbols[] = {"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"};
    
    // LeetCode requires dynamic allocation or static buffers for returned strings.
    // Max size needed for constraints (num <= 3999) is "MMMCMXCIX" (9 chars) + 1 for '\0'.
    static char roman[20]; 
    roman[0] = '\0'; // Reset the buffer for each run
    
    for (int i = 0; i < 13; i++) {
        // While the current value can be subtracted from num
        while (num >= values[i]) {
            strcat(roman, symbols[i]); // Append the symbol
            num -= values[i];          // Deduct the value
        }
    }
    
    return roman;
}
