int removeElement(int* nums, int numsSize, int val) {
    // 'k' tracks the count and index of elements not equal to val
    int k = 0;
    
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not the target value
        if (nums[i] != val) {
            nums[k] = nums[i];
            k++;
        }
    }
    
    return k;
}
