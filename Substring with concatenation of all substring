#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define HASH_SIZE 1013 // Prime number for hash table capacity

// Structure to track word frequencies in our Hash Map
typedef struct {
    char* word;
    int count;
} HashEntry;

// Simple polynomial rolling hash function
unsigned int getHash(const char* str, int len) {
    unsigned int hash = 0;
    for (int i = 0; i < len; i++) {
        hash = hash * 31 + str[i];
    }
    return hash % HASH_SIZE;
}

// Inserts or increments a word count in the hash map (Linear Probing)
void insertWord(HashEntry* table, const char* str, int len) {
    unsigned int idx = getHash(str, len);
    while (table[idx].word != NULL) {
        if (strncmp(table[idx].word, str, len) == 0 && strlen(table[idx].word) == len) {
            table[idx].count++;
            return;
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    table[idx].word = strndup(str, len);
    table[idx].count = 1;
}

// Retrieves the expected total frequency of a word from the base map
int getWordCount(HashEntry* table, const char* str, int len) {
    unsigned int idx = getHash(str, len);
    while (table[idx].word != NULL) {
        if (strncmp(table[idx].word, str, len) == 0 && strlen(table[idx].word) == len) {
            return table[idx].count;
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    return 0;
}

